# ==============================================================================
# DecisionSphere — Canonical Environment Configuration Template
# Copy this file to .env and customize for local or production deployments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Settings
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=false
APP_NAME="DecisionSphere API"
APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=decisionsphere
POSTGRES_PORT=5432
BACKEND_PORT=8000

# SECURITY WARNING: The default password 'postgres' is for local evaluation only.
# In production, ALWAYS generate a strong random secret and inject via secrets manager.
POSTGRES_PASSWORD=postgres

# Centralized SQLAlchemy / Alembic Database URL
# Local development without Docker: postgresql://postgres:postgres@localhost:5432/decisionsphere
# Docker Compose: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisionsphere

# ------------------------------------------------------------------------------
# 3. Logging and Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------------------------
# 4. CORS Whitelist
# ------------------------------------------------------------------------------
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# ------------------------------------------------------------------------------
# 5. Security Boundary (Optional Header Authentication)
# ------------------------------------------------------------------------------
API_KEY=
API_KEY_HEADER_NAME="X-API-Key"
